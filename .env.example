# Gemini API Key used strictly for embeddings (paid key recommended for high throughput)
GEMINI_EMBED_API_KEY=your_gemini_embed_api_key_here

# Gemini API Key used strictly for chat LLM (free-tier key)
GEMINI_LLM_API_KEY=your_gemini_llm_api_key_here

# Chat LLM model for the agent (defaults to gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Storage paths (optional overrides)
DATA_DIR=./data
DB_PATH=./nba_stats.db
